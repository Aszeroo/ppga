# PPGA environment variables — copy to your deploy environment, never commit this file
#
# Browser-visible (safe for the browser bundle; anything with the NEXT_PUBLIC_ prefix)
# Only the anon key is allowed to reach the browser.
NEXT_PUBLIC_SUP_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUP_ANON_KEY=eyJh...anon-key...

# Server-only (never shipped to the browser; CI/Vercel secrets only)
SUP_URL=https://your-project-ref.supabase.co
SUP_SERVICE_ROLE_KEY=ey...service-role-key...

# Auth throttling (ticket #63). Failed sign-ins and password changes are
# counted per-handle and per-IP in fixed windows; blocks answer 429 with
# Retry-After. Defaults shown below are used when a variable is absent/invalid.
# NOTE: counters live in the app instance's memory. A serverless/multi-instance
# deployment counts per instance; layer Supabase Auth's own limits or a shared
# store if a single global window is required.
PPGA_AUTH_HANDLE_MAX_ATTEMPTS=5
PPGA_AUTH_IP_MAX_ATTEMPTS=50
PPGA_AUTH_WINDOW_SECONDS=900

# Mutating-route Origin allowlist (ticket #63). Comma-separated absolute
# origins. Leave unset to derive the allowed origin from the request's own
# Host/x-forwarded-host (works for Vercel preview deployments).
# PPGA_ALLOWED_ORIGINS=https://ppga.example.com,https://preview.ppga.example.com

# Vercel deployment targets for dev/preview/prod environment mapping
# (operator action: `vercel deploy --preview --token` in dev, `vercel deploy --prod --token` in production)
# The Vercel project is the single source for environment secret sets:
#   dev    -> local supabase instance (supabase start, local Postgres)
#   preview -> Supabase preview project ref
#   production -> Supabase production project ref